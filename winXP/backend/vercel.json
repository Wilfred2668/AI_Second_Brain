{
  "version": 2,
  "builds": [
    {
      "src": "app.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "app.py"
    }
  ],
  "env": {
    "QDRANT_URL": "@qdrant_url",
    "QDRANT_API_KEY": "@qdrant_api_key",
    "GEMINI_API_KEY": "@gemini_api_key",
    "COLLECTION_NAME": "memories",
    "VECTOR_SIZE": "384"
  }
}
